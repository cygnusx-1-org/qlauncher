    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Увімкніть службу, щоб виконувати дію під час завантаження, налаштовувати кнопки пульта, посилити батьківський контроль і виявляти бездіяльність для керування живленням. Вона бачить натискання апаратних кнопок і назву активного застосунку; ці дані зберігаються лише в пам’яті цього пристрою й нікуди не надсилаються.</string>

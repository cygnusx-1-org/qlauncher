    <!-- First run -->
    <string name="firstrun_welcome_title">ברוכים הבאים!</string>
    <string name="firstrun_welcome_text">המשגר QLauncher נועד ל-Android TV. הוא מרכז את האפליקציות, הערוצים והתוכן המועדף שלך במסך בית אחד שאפשר להתאים אישית, עם טפט מתחלף ברקע.</string>
    <string name="firstrun_features_title">כוחות העל החדשים שלך</string>
    <string name="firstrun_features_text">הפעלת אפליקציה או כניסת HDMI באתחול, ניהול פרופילי תצוגה, נעילת אפליקציות בבקרת הורים, הצגת תבניות כיול, זיהוי חוסר פעילות והתאמה אישית של כל חלק במסך הבית. חלק מהתכונות תלויות במכשיר.</string>
    <string name="firstrun_a11y_title">בואו נפעיל נגישות</string>
    <string name="firstrun_a11y_text">תכונות רבות זקוקות לשירות הנגישות של QLauncher: החלפת המשגר המקורי, פעולות באתחול, מחוות בלחצני השלט, זיהוי חוסר פעילות ובקרת הורים. אפשר להפעיל אותו עכשיו או מאוחר יותר מההגדרות.</string>
    <string name="firstrun_a11y_open">פתיחת הגדרות הנגישות</string>
    <string name="firstrun_permissions_title">אם יורשה לי…</string>
    <string name="firstrun_permissions_text">בהמשך, QLauncher תבקש הרשאה לקרוא את לוח השידורים (עבור הערוצים ו\"המשך צפייה\") וגישה להתראות (עבור סמל ההתראות ו\"מתנגן עכשיו\"). שתי ההרשאות אופציונליות.</string>
    <!-- Before Android 8 there are no channels, so only notification access is asked for. -->
    <string name="firstrun_permissions_text_no_channels">בהמשך, QLauncher תבקש גישה להתראות (עבור סמל ההתראות ו\"מתנגן עכשיו\"). זה אופציונלי.</string>
    <string name="firstrun_notifications_dialog">לאפשר גישה להתראות?</string>
    <string name="firstrun_notifications_text">גישה להתראות מאפשרת ל-QLauncher להציג את מספר ההתראות, חלונית התראות ואת מה שמתנגן. \"כן\" פותח את דף הגישה המיוחדת לאפליקציות, שבו מעניקים אותה.</string>
    <string name="firstrun_reports_title">לשלוח דוחות אנונימיים על קריסות ושגיאות?</string>
    <string name="firstrun_reports_text">אם QLauncher קורסת או נתקלת בשגיאה, היא יכולה לשלוח דוח עם גרסת האפליקציה ודגם המכשיר כדי שאפשר יהיה לתקן את הבאג. שום דבר שמזהה אותך או את מה שצופים בו לא נשלח. אפשר לשנות את זה מאוחר יותר ב\"כללי\".</string>
    <string name="firstrun_launcher_title">הגדרת QLauncher כמסך הבית</string>
    <string name="firstrun_launcher_text">מכשירי טלוויזיה רבים לא מאפשרים לשנות את משגר ברירת המחדל. אם המכשיר שלך מאפשר, יש לבחור שם ב-QLauncher. אחרת, יש להפעיל את שירות הנגישות עם \"עקיפת המשגר הנוכחי\", ו-QLauncher תחזור בכל פעם שהמשגר המקורי נפתח.</string>
    <string name="firstrun_launcher_open">שינוי משגר ברירת המחדל</string>
    <string name="firstrun_start_title">הגיע הזמן להתחיל!</string>
    <string name="firstrun_start_text">אפשר לשנות הכול מאוחר יותר מההגדרות. יש ללחוץ על לחצן ההגדרות בפינה הימנית העליונה, או על רצף המקשים ↑→↓←↑→↓←.</string>

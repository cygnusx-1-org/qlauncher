    <!-- First run -->
    <string name="firstrun_welcome_title">მოგესალმებით!</string>
    <string name="firstrun_welcome_text">QLauncher არის ლაუნჩერი Android TV-სთვის. ის თქვენს აპებს, არხებს და საყვარელ კონტენტს ერთ მორგებად მთავარ ეკრანზე აერთიანებს, რომლის უკანაც ფონები იცვლება.</string>
    <string name="firstrun_features_title">თქვენი ახალი სუპერძალები</string>
    <string name="firstrun_features_text">გაუშვით აპი ან HDMI შესასვლელი ჩართვისას, მართეთ ეკრანის პროფილები, ჩაკეტეთ აპები მშობელთა კონტროლით, აჩვენეთ კალიბრაციის შაბლონები, აღმოაჩინეთ უმოქმედობა და მოარგეთ მთავარი ეკრანის ყველა ნაწილი. ზოგიერთი ფუნქცია თქვენს მოწყობილობაზეა დამოკიდებული.</string>
    <string name="firstrun_a11y_title">ჩავრთოთ მარტივი წვდომა</string>
    <string name="firstrun_a11y_text">ბევრ ფუნქციას სჭირდება QLauncher-ის მარტივი წვდომის სერვისი: ჩაშენებული ლაუნჩერის ჩანაცვლება, მოქმედებები ჩართვისას, პულტის ღილაკების ჟესტები, უმოქმედობის აღმოჩენა და მშობელთა კონტროლი. მისი ჩართვა შეგიძლიათ ახლა ან მოგვიანებით, პარამეტრებიდან.</string>
    <string name="firstrun_a11y_open">მარტივი წვდომის პარამეტრების გახსნა</string>
    <string name="firstrun_permissions_title">თუ ნებას მომცემთ…</string>
    <string name="firstrun_permissions_text">შემდეგ QLauncher ითხოვს ნებართვას TV პროგრამის წასაკითხად (არხებისთვის და „შემდეგი საყურებელი“ რიგისთვის) და შეტყობინებებზე წვდომას (შეტყობინების ხატულისთვის და „ახლა უკრავს“ ფუნქციისთვის). ორივე არასავალდებულოა.</string>
    <!-- Before Android 8 there are no channels, so only notification access is asked for. -->
    <string name="firstrun_permissions_text_no_channels">შემდეგ QLauncher ითხოვს შეტყობინებებზე წვდომას (შეტყობინების ხატულისთვის და „ახლა უკრავს“ ფუნქციისთვის). ეს არასავალდებულოა.</string>
    <string name="firstrun_notifications_dialog">დავუშვათ შეტყობინებებზე წვდომა?</string>
    <string name="firstrun_notifications_text">შეტყობინებებზე წვდომით QLauncher აჩვენებს შეტყობინებების რაოდენობას, შეტყობინებების პანელს და იმას, რაც ახლა უკრავს. „დიახ“ ხსნის სპეციალური ნებართვების გვერდს, სადაც ამ წვდომას მისცემთ.</string>
    <string name="firstrun_reports_title">გავაგზავნოთ ანონიმური ანგარიშები?</string>
    <string name="firstrun_reports_text">თუ QLauncher ავარიულად დაიხურება ან შეცდომას წააწყდება, მას შეუძლია გაგზავნოს ანგარიში აპის ვერსიით და მოწყობილობის მოდელით, რათა ხარვეზი გასწორდეს. არ იგზავნება არაფერი, რაც თქვენს ვინაობას ან თქვენს საყურებელს გაამჟღავნებს. ამის შეცვლა მოგვიანებით შეგიძლიათ განყოფილებაში „ზოგადი“.</string>
    <string name="firstrun_launcher_title">დააყენეთ QLauncher მთავარ ეკრანად</string>
    <string name="firstrun_launcher_text">ბევრი TV მოწყობილობა არ იძლევა ნაგულისხმევი ლაუნჩერის შეცვლის საშუალებას. თუ თქვენი იძლევა, აირჩიეთ იქ QLauncher. სხვა შემთხვევაში ჩართეთ მარტივი წვდომის სერვისი პარამეტრით „მიმდინარე ლაუნჩერის ჩანაცვლება“ და QLauncher დაბრუნდება ყოველ ჯერზე, როცა ჩაშენებული ლაუნჩერი გაიხსნება.</string>
    <string name="firstrun_launcher_open">ნაგულისხმევი ლაუნჩერის შეცვლა</string>
    <string name="firstrun_start_title">დროა დავიწყოთ!</string>
    <string name="firstrun_start_text">ყველაფრის შეცვლა მოგვიანებით პარამეტრებიდან შეიძლება. დააჭირეთ პარამეტრების ღილაკს ზედა მარჯვენა კუთხეში ან ღილაკების თანმიმდევრობას ↑→↓←↑→↓←.</string>

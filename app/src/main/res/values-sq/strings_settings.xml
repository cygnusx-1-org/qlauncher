    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Aktivizo shërbimin për të kryer një veprim gjatë nisjes, për të personalizuar butonat e telekomandës, për të forcuar kontrollin prindëror dhe për të zbuluar pasivitetin për kontrollin e energjisë. Ai sheh shtypjet e butonave fizikë dhe emrin e aplikacionit në plan të parë; të dyja mbeten në kujtesën e kësaj pajisjeje dhe nuk dërgohen askund.</string>
    <string name="settings_a11y_enabled">I aktivizuar</string>
    <string name="settings_a11y_started">I nisur</string>
    <string name="settings_yes">Po</string>
    <string name="settings_no">Jo</string>
    <string name="settings_a11y_open">Shfaq cilësimet e qasshmërisë</string>
    <string name="settings_a11y_consent_title">Shërbimi i qasshmërisë</string>
    <string name="settings_a11y_consent">Kjo i lejon QLauncher të shohë shtypjet e butonave fizikë dhe emrin e aplikacionit në plan të parë. Të dyja mbahen vetëm në kujtesën e kësaj pajisjeje dhe nuk dërgohen askund. A pajtohesh?</string>
    <string name="settings_a11y_alternate">Përdor konfigurimin alternativ</string>
    <string name="settings_a11y_alternate_desc">Rregullon probleme në disa pajisje</string>
    <string name="settings_a11y_volume_fix">Rregullimi i butonave të volumit</string>
    <string name="settings_a11y_volume_fix_desc">Ndalon për pak kohë ricaktimin kur shtypet volumi, që shtypjet e gjata të funksionojnë ende</string>
    <string name="settings_a11y_remap">Aktivizo ricaktimin e butonave</string>
    <string name="settings_a11y_remap_desc">Shërbimi kap shtypjet e butonave. Çaktivizimi shmang problemet me shtypjen e gjatë të volumit dhe ndalimin e shërbimit nga sistemi, por zëvendësimi i lëshuesit, kontrolli prindëror dhe zbulimi i pasivitetit mund të jenë më pak efektivë.</string>
    <string name="settings_a11y_reminder">Shfaq kujtesën</string>

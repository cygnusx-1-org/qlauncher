    <!-- First run -->
    <string name="firstrun_welcome_title">Chào mừng!</string>
    <string name="firstrun_welcome_text">QLauncher là trình khởi chạy dành cho Android TV. Ứng dụng đưa các ứng dụng, kênh và nội dung yêu thích của bạn lên một màn hình chính có thể tùy chỉnh, với hình nền luân phiên phía sau.</string>
    <string name="firstrun_features_title">Siêu năng lực mới của bạn</string>
    <string name="firstrun_features_text">Mở một ứng dụng hoặc đầu vào HDMI khi khởi động, quản lý cấu hình hiển thị, khóa ứng dụng bằng kiểm soát của cha mẹ, hiển thị mẫu hiệu chỉnh, phát hiện thời gian không hoạt động và tùy chỉnh mọi phần của màn hình chính. Một số tính năng phụ thuộc vào thiết bị của bạn.</string>
    <string name="firstrun_a11y_title">Cùng bật hỗ trợ tiếp cận nào</string>
    <string name="firstrun_a11y_text">Nhiều tính năng cần dịch vụ hỗ trợ tiếp cận của QLauncher: thay thế trình khởi chạy gốc, tác vụ khi khởi động, thao tác nút trên điều khiển từ xa, phát hiện không hoạt động và kiểm soát của cha mẹ. Bạn có thể bật ngay bây giờ hoặc sau này trong phần cài đặt.</string>
    <string name="firstrun_a11y_open">Mở cài đặt hỗ trợ tiếp cận</string>
    <string name="firstrun_permissions_title">Xin phép một chút…</string>
    <string name="firstrun_permissions_text">Tiếp theo, QLauncher sẽ xin quyền đọc danh sách chương trình TV (cho kênh và Xem tiếp) và quyền truy cập thông báo (cho biểu tượng thông báo và Đang phát). Cả hai đều không bắt buộc.</string>
    <!-- Before Android 8 there are no channels, so only notification access is asked for. -->
    <string name="firstrun_permissions_text_no_channels">Tiếp theo, QLauncher sẽ xin quyền truy cập thông báo (cho biểu tượng thông báo và Đang phát). Quyền này không bắt buộc.</string>
    <string name="firstrun_notifications_dialog">Cho phép truy cập thông báo?</string>
    <string name="firstrun_notifications_text">Quyền truy cập thông báo cho phép QLauncher hiển thị số lượng thông báo, bảng thông báo và nội dung đang phát. Chọn Có sẽ mở trang Quyền truy cập đặc biệt của ứng dụng, nơi bạn cấp quyền này.</string>
    <string name="firstrun_reports_title">Gửi báo cáo sự cố và lỗi ẩn danh?</string>
    <string name="firstrun_reports_text">Nếu QLauncher gặp sự cố hoặc lỗi, ứng dụng có thể gửi báo cáo kèm phiên bản ứng dụng và kiểu máy thiết bị để lỗi được khắc phục. Không có thông tin nào nhận dạng bạn hoặc nội dung bạn xem được gửi đi. Bạn có thể thay đổi tùy chọn này sau trong mục Chung.</string>
    <string name="firstrun_launcher_title">Đặt QLauncher làm màn hình chính</string>
    <string name="firstrun_launcher_text">Nhiều thiết bị TV không cho phép thay đổi trình khởi chạy mặc định. Nếu thiết bị của bạn cho phép, hãy chọn QLauncher ở đó. Nếu không, hãy bật dịch vụ hỗ trợ tiếp cận với “Ghi đè trình khởi chạy hiện tại”, và QLauncher sẽ quay lại mỗi khi trình khởi chạy gốc mở ra.</string>
    <string name="firstrun_launcher_open">Thay đổi trình khởi chạy mặc định</string>
    <string name="firstrun_start_title">Bắt đầu thôi!</string>
    <string name="firstrun_start_text">Mọi thứ đều có thể thay đổi sau trong phần cài đặt. Nhấn nút cài đặt ở góc trên bên phải, hoặc chuỗi phím ↑→↓←↑→↓←.</string>

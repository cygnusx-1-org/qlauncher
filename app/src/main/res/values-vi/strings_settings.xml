    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Bật dịch vụ để chạy tác vụ khi khởi động, tùy chỉnh nút trên điều khiển từ xa, tăng cường kiểm soát của cha mẹ và phát hiện thời gian không hoạt động để quản lý nguồn. Dịch vụ nhận biết các lần nhấn phím phần cứng và tên ứng dụng ở nền trước; cả hai chỉ được lưu trong bộ nhớ của thiết bị này và không bao giờ được gửi đi đâu.</string>
    <string name="settings_a11y_enabled">Đã bật</string>
    <string name="settings_a11y_started">Đã khởi chạy</string>
    <string name="settings_yes">Có</string>
    <string name="settings_no">Không</string>
    <string name="settings_a11y_open">Hiện cài đặt hỗ trợ tiếp cận</string>
    <string name="settings_a11y_consent_title">Dịch vụ hỗ trợ tiếp cận</string>
    <string name="settings_a11y_consent">Điều này cho phép QLauncher nhận biết các lần nhấn nút phần cứng và tên ứng dụng ở nền trước. Cả hai chỉ được giữ trong bộ nhớ của thiết bị này và không bao giờ được gửi đi đâu. Bạn có đồng ý không?</string>
    <string name="settings_a11y_alternate">Dùng thiết lập thay thế</string>
    <string name="settings_a11y_alternate_desc">Khắc phục sự cố trên một số thiết bị</string>
    <string name="settings_a11y_volume_fix">Sửa lỗi nút âm lượng</string>
    <string name="settings_a11y_volume_fix_desc">Tạm dừng gán lại nút trong giây lát khi nhấn âm lượng, để nhấn giữ vẫn hoạt động</string>
    <string name="settings_a11y_remap">Bật gán lại nút</string>

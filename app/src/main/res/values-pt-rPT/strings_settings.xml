    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Ative o serviço para executar uma ação no arranque, personalizar os botões do comando, reforçar o controlo parental e detetar inatividade para a gestão de energia. Vê as teclas físicas premidas e o nome da aplicação em primeiro plano; ambos ficam na memória deste dispositivo e nunca são enviados para lado nenhum.</string>
    <string name="settings_a11y_enabled">Ativado</string>
    <string name="settings_a11y_started">Iniciado</string>
    <string name="settings_yes">Sim</string>
    <string name="settings_no">Não</string>
    <string name="settings_a11y_open">Mostrar definições de acessibilidade</string>
    <string name="settings_a11y_consent_title">Serviço de acessibilidade</string>
    <string name="settings_a11y_consent">Isto permite ao QLauncher ver os botões físicos premidos e o nome da aplicação em primeiro plano. Ambos ficam apenas na memória deste dispositivo e nunca são enviados para lado nenhum. Concorda?</string>
    <string name="settings_a11y_alternate">Utilizar configuração alternativa</string>
    <string name="settings_a11y_alternate_desc">Corrige problemas em alguns dispositivos</string>
    <string name="settings_a11y_volume_fix">Correção dos botões de volume</string>
    <string name="settings_a11y_volume_fix_desc">Interrompe brevemente o remapeamento ao premir o volume, para que as pressões longas continuem a funcionar</string>
    <string name="settings_a11y_remap">Ativar remapeamento de botões</string>
    <string name="settings_a11y_remap_desc">O serviço interceta as teclas premidas. Desativar esta opção evita problemas com a pressão longa no volume e que o sistema pare o serviço, mas a substituição do launcher, o controlo parental e a deteção de inatividade podem ser menos eficazes.</string>

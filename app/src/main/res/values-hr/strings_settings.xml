    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Uključite uslugu kako biste pokretali radnju pri uključivanju, prilagodili tipke daljinskog upravljača, ojačali roditeljski nadzor i otkrivali neaktivnost za upravljanje napajanjem. Usluga vidi pritiske hardverskih tipki i naziv aplikacije u prvom planu; oboje ostaje u memoriji ovog uređaja i nikamo se ne šalje.</string>
    <string name="settings_a11y_enabled">Omogućeno</string>
    <string name="settings_a11y_started">Pokrenuto</string>
    <string name="settings_yes">Da</string>
    <string name="settings_no">Ne</string>
    <string name="settings_a11y_open">Prikaži postavke pristupačnosti</string>
    <string name="settings_a11y_consent_title">Usluga pristupačnosti</string>
    <string name="settings_a11y_consent">To QLauncheru omogućuje da vidi pritiske hardverskih tipki i naziv aplikacije u prvom planu. Oboje se čuva samo u memoriji ovog uređaja i nikad se nikamo ne šalje. Slažete li se?</string>
    <string name="settings_a11y_alternate">Koristi zamjensku konfiguraciju</string>
    <string name="settings_a11y_alternate_desc">Rješava probleme na nekim uređajima</string>
    <string name="settings_a11y_volume_fix">Popravak tipki za glasnoću</string>
    <string name="settings_a11y_volume_fix_desc">Kratko zaustavlja preslikavanje pri pritisku tipke za glasnoću kako bi dugi pritisci i dalje radili</string>
    <string name="settings_a11y_remap">Omogući preslikavanje tipki</string>
    <string name="settings_a11y_remap_desc">Usluga presreće pritiske tipki. Isključivanjem se izbjegavaju problemi s dugim pritiskom tipke za glasnoću i zaustavljanje usluge od strane sustava, ali zamjena pokretača, roditeljski nadzor i otkrivanje neaktivnosti mogu biti manje učinkoviti.</string>
    <string name="settings_a11y_reminder">Prikaži podsjetnik</string>

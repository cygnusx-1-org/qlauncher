    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Zapněte službu, abyste mohli spouštět akci po startu, přizpůsobit tlačítka dálkového ovladače, posílit rodičovskou kontrolu a zjišťovat nečinnost pro řízení napájení. Vidí stisknutí hardwarových tlačítek a název aplikace v popředí; obojí zůstává jen v paměti tohoto zařízení a nikam se neodesílá.</string>
    <string name="settings_a11y_enabled">Povoleno</string>
    <string name="settings_a11y_started">Spuštěno</string>

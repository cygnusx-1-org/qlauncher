    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Activeu el servei per executar una acció en arrencar, personalitzar els botons del comandament, reforçar el control parental i detectar la inactivitat per a la gestió de l\'energia. Veu les pulsacions de les tecles físiques i el nom de l\'aplicació en primer pla; totes dues dades es queden a la memòria d\'aquest dispositiu i no s\'envien enlloc.</string>
    <string name="settings_a11y_enabled">Activat</string>
    <string name="settings_a11y_started">Iniciat</string>
    <string name="settings_yes">Sí</string>
    <string name="settings_no">No</string>
    <string name="settings_a11y_open">Mostra la configuració d\'accessibilitat</string>
    <string name="settings_a11y_consent_title">Servei d\'accessibilitat</string>
    <string name="settings_a11y_consent">Això permet que QLauncher vegi les pulsacions dels botons físics i el nom de l\'aplicació en primer pla. Totes dues dades es conserven només a la memòria d\'aquest dispositiu i no s\'envien enlloc. Hi esteu d\'acord?</string>
    <string name="settings_a11y_alternate">Utilitza la configuració alternativa</string>
    <string name="settings_a11y_alternate_desc">Soluciona problemes en alguns dispositius</string>
    <string name="settings_a11y_volume_fix">Correcció dels botons de volum</string>
    <string name="settings_a11y_volume_fix_desc">Atura breument la reassignació quan es prem el volum, perquè les pulsacions llargues continuïn funcionant</string>
    <string name="settings_a11y_remap">Activa la reassignació de botons</string>
    <string name="settings_a11y_remap_desc">El servei intercepta les pulsacions de tecles. Desactivar-ho evita problemes amb les pulsacions llargues del volum i que el sistema aturi el servei, però la substitució del llançador, el control parental i la detecció d\'inactivitat poden ser menys efectius.</string>
    <string name="settings_a11y_reminder">Mostra un recordatori</string>
    <string name="settings_a11y_reminder_desc">Si el servei d\'accessibilitat està desactivat</string>

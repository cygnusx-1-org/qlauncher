    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Zapnite službu, aby ste mohli spúšťať akciu pri štarte, prispôsobiť tlačidlá diaľkového ovládača, posilniť rodičovskú kontrolu a zisťovať nečinnosť na riadenie napájania. Vidí stlačenia hardvérových tlačidiel a názov aplikácie v popredí; oboje zostáva iba v pamäti tohto zariadenia a nikam sa neodosiela.</string>

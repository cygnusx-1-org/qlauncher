    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Aktifkan layanan ini untuk menjalankan tindakan saat booting, menyesuaikan tombol remote, memperkuat kontrol orang tua, dan mendeteksi waktu tidak aktif untuk kontrol daya. Layanan ini melihat penekanan tombol fisik dan nama aplikasi yang ada di depan; keduanya tetap berada di memori perangkat ini dan tidak pernah dikirim ke mana pun.</string>
    <string name="settings_a11y_enabled">Diaktifkan</string>
    <string name="settings_a11y_started">Berjalan</string>
    <string name="settings_yes">Ya</string>
    <string name="settings_no">Tidak</string>
    <string name="settings_a11y_open">Tampilkan setelan Aksesibilitas</string>
    <string name="settings_a11y_consent_title">Layanan aksesibilitas</string>
    <string name="settings_a11y_consent">Ini memungkinkan QLauncher melihat penekanan tombol fisik dan nama aplikasi yang ada di latar depan. Keduanya hanya disimpan di memori perangkat ini dan tidak pernah dikirim ke mana pun. Apakah Anda setuju?</string>
    <string name="settings_a11y_alternate">Gunakan konfigurasi alternatif</string>
    <string name="settings_a11y_alternate_desc">Memperbaiki masalah di beberapa perangkat</string>
    <string name="settings_a11y_volume_fix">Perbaikan tombol volume</string>
    <string name="settings_a11y_volume_fix_desc">Hentikan pemetaan ulang sejenak saat volume ditekan, agar tekan lama tetap berfungsi</string>
    <string name="settings_a11y_remap">Aktifkan pemetaan ulang tombol</string>
    <string name="settings_a11y_remap_desc">Layanan ini mencegat penekanan tombol. Menonaktifkannya menghindari masalah tekan lama tombol volume dan sistem yang menghentikan layanan, tetapi pengambilalihan launcher, kontrol orang tua, dan deteksi waktu tidak aktif mungkin kurang efektif.</string>
    <string name="settings_a11y_reminder">Tampilkan pengingat</string>
    <string name="settings_a11y_reminder_desc">Jika layanan aksesibilitas dinonaktifkan</string>
    <string name="settings_a11y_unbound_toast">Layanan aksesibilitas QLauncher tidak berjalan</string>


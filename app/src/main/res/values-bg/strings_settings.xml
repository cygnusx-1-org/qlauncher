    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Включете услугата, за да изпълнявате действие при включване, да персонализирате бутоните на дистанционното, да засилите родителския контрол и да откривате бездействие за управление на захранването. Тя вижда натисканията на хардуерните бутони и името на приложението на преден план; и двете остават в паметта на това устройство и никога не се изпращат никъде.</string>
    <string name="settings_a11y_enabled">Активирана</string>
    <string name="settings_a11y_started">Стартирана</string>
    <string name="settings_yes">Да</string>
    <string name="settings_no">Не</string>
    <string name="settings_a11y_open">Показване на настройките за достъпност</string>
    <string name="settings_a11y_consent_title">Услуга за достъпност</string>
    <string name="settings_a11y_consent">Това позволява на QLauncher да вижда натисканията на хардуерните бутони и името на приложението на преден план. И двете се пазят само в паметта на това устройство и никога не се изпращат никъде. Съгласни ли сте?</string>
    <string name="settings_a11y_alternate">Използване на алтернативна конфигурация</string>
    <string name="settings_a11y_alternate_desc">Отстранява проблеми на някои устройства</string>
    <string name="settings_a11y_volume_fix">Поправка за бутоните за сила на звука</string>
    <string name="settings_a11y_volume_fix_desc">Кратко спиране на пренасочването при натискане на бутон за сила на звука, така че продължителното натискане да продължи да работи</string>
    <string name="settings_a11y_remap">Активиране на пренасочването на бутоните</string>
    <string name="settings_a11y_remap_desc">Услугата прихваща натисканията на бутони. Изключването избягва проблеми с продължителното натискане на бутоните за сила на звука и спирането на услугата от системата, но замяната на лаунчера, родителският контрол и откриването на бездействие може да са по-малко ефективни.</string>
    <string name="settings_a11y_reminder">Показване на напомняне</string>
    <string name="settings_a11y_reminder_desc">Ако услугата за достъпност е изключена</string>

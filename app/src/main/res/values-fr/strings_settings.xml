    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Activez le service pour exécuter une action au démarrage, personnaliser les boutons de la télécommande, renforcer le contrôle parental et détecter l\'inactivité pour la gestion de l\'alimentation. Il voit les appuis sur les touches physiques et le nom de l\'application au premier plan ; ces deux informations restent en mémoire sur cet appareil et ne sont jamais envoyées nulle part.</string>
    <string name="settings_a11y_enabled">Activé</string>
    <string name="settings_a11y_started">Démarré</string>
    <string name="settings_yes">Oui</string>
    <string name="settings_no">Non</string>
    <string name="settings_a11y_open">Afficher les paramètres d\'accessibilité</string>
    <string name="settings_a11y_consent_title">Service d\'accessibilité</string>
    <string name="settings_a11y_consent">Cela permet à QLauncher de voir les appuis sur les boutons physiques et le nom de l\'application au premier plan. Ces deux informations sont conservées uniquement en mémoire sur cet appareil et ne sont jamais envoyées nulle part. Acceptez-vous ?</string>
    <string name="settings_a11y_alternate">Utiliser la configuration alternative</string>
    <string name="settings_a11y_alternate_desc">Corrige des problèmes sur certains appareils</string>
    <string name="settings_a11y_volume_fix">Correctif des boutons de volume</string>
    <string name="settings_a11y_volume_fix_desc">Suspendre brièvement la réattribution quand une touche de volume est pressée, pour que les appuis longs fonctionnent toujours</string>
    <string name="settings_a11y_remap">Activer la réattribution des boutons</string>
    <string name="settings_a11y_remap_desc">Le service intercepte les appuis sur les touches. Désactiver cette option évite les problèmes d\'appui long sur le volume et l\'arrêt du service par le système, mais le remplacement du lanceur, le contrôle parental et la détection d\'inactivité peuvent être moins efficaces.</string>
    <string name="settings_a11y_reminder">Afficher un rappel</string>
    <string name="settings_a11y_reminder_desc">Si le service d\'accessibilité est désactivé</string>
    <string name="settings_a11y_unbound_toast">Le service d\'accessibilité de QLauncher ne fonctionne pas</string>


    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Включите службу, чтобы выполнять действие при загрузке, настраивать кнопки пульта, усилить родительский контроль и определять бездействие для управления питанием. Она видит нажатия аппаратных кнопок и название активного приложения; эти данные хранятся только в памяти этого устройства и никуда не отправляются.</string>
    <string name="settings_a11y_enabled">Включено</string>
    <string name="settings_a11y_started">Запущено</string>
    <string name="settings_yes">Да</string>
    <string name="settings_no">Нет</string>
    <string name="settings_a11y_open">Открыть настройки спец. возможностей</string>
    <string name="settings_a11y_consent_title">Служба спец. возможностей</string>
    <string name="settings_a11y_consent">Это позволит QLauncher видеть нажатия аппаратных кнопок и название приложения на переднем плане. Эти данные хранятся только в памяти этого устройства и никуда не отправляются. Вы согласны?</string>
    <string name="settings_a11y_alternate">Альтернативная конфигурация</string>
    <string name="settings_a11y_alternate_desc">Устраняет проблемы на некоторых устройствах</string>
    <string name="settings_a11y_volume_fix">Исправление кнопок громкости</string>
    <string name="settings_a11y_volume_fix_desc">Ненадолго отключать переназначение при нажатии громкости, чтобы долгое нажатие продолжало работать</string>
    <string name="settings_a11y_remap">Включить переназначение кнопок</string>
    <string name="settings_a11y_remap_desc">Служба перехватывает нажатия клавиш. Если это отключить, исчезнут проблемы с долгим нажатием громкости и остановкой службы системой, но замена лаунчера, родительский контроль и определение бездействия могут работать хуже.</string>

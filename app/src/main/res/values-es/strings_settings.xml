    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Activa el servicio para ejecutar una acción al arrancar, personalizar los botones del mando, reforzar el control parental y detectar la inactividad para el control de energía. Ve las pulsaciones de las teclas físicas y el nombre de la aplicación en primer plano; ambos datos se quedan en la memoria de este dispositivo y nunca se envían a ningún sitio.</string>
    <string name="settings_a11y_enabled">Activado</string>
    <string name="settings_a11y_started">Iniciado</string>
    <string name="settings_yes">Sí</string>
    <string name="settings_no">No</string>
    <string name="settings_a11y_open">Mostrar ajustes de accesibilidad</string>
    <string name="settings_a11y_consent_title">Servicio de accesibilidad</string>
    <string name="settings_a11y_consent">Esto permite que QLauncher vea las pulsaciones de los botones físicos y el nombre de la aplicación en primer plano. Ambos datos se guardan solo en la memoria de este dispositivo y nunca se envían a ningún sitio. ¿Estás de acuerdo?</string>
    <string name="settings_a11y_alternate">Usar configuración alternativa</string>
    <string name="settings_a11y_alternate_desc">Corrige problemas en algunos dispositivos</string>
    <string name="settings_a11y_volume_fix">Corrección de los botones de volumen</string>
    <string name="settings_a11y_volume_fix_desc">Deja de reasignar brevemente al pulsar el volumen, para que las pulsaciones largas sigan funcionando</string>
    <string name="settings_a11y_remap">Activar reasignación de botones</string>
    <string name="settings_a11y_remap_desc">El servicio intercepta las pulsaciones de teclas. Desactivarlo evita problemas con la pulsación larga del volumen y que el sistema detenga el servicio, pero la sustitución del launcher, el control parental y la detección de inactividad pueden ser menos eficaces.</string>
    <string name="settings_a11y_reminder">Mostrar recordatorio</string>
    <string name="settings_a11y_reminder_desc">Si el servicio de accesibilidad está desactivado</string>
    <string name="settings_a11y_unbound_toast">El servicio de accesibilidad de QLauncher no está en ejecución</string>


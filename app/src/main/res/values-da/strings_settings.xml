    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Slå tjenesten til for at køre en handling ved opstart, tilpasse fjernbetjeningens knapper, styrke forældrekontrollen og registrere inaktivitet til strømstyring. Den ser tryk på hardwaretaster og navnet på appen i forgrunden; begge dele bliver i hukommelsen på denne enhed og sendes aldrig nogen steder hen.</string>
    <string name="settings_a11y_enabled">Aktiveret</string>
    <string name="settings_a11y_started">Startet</string>
    <string name="settings_yes">Ja</string>
    <string name="settings_no">Nej</string>
    <string name="settings_a11y_open">Vis indstillinger for hjælpefunktioner</string>
    <string name="settings_a11y_consent_title">Hjælpefunktionstjeneste</string>
    <string name="settings_a11y_consent">Dette giver QLauncher mulighed for at se tryk på hardwareknapper og navnet på appen i forgrunden. Begge dele opbevares kun i hukommelsen på denne enhed og sendes aldrig nogen steder hen. Accepterer du?</string>
    <string name="settings_a11y_alternate">Brug alternativ konfiguration</string>
    <string name="settings_a11y_alternate_desc">Løser problemer på visse enheder</string>
    <string name="settings_a11y_volume_fix">Rettelse til lydstyrkeknapper</string>
    <string name="settings_a11y_volume_fix_desc">Stop kortvarigt omtildelingen, når der trykkes på lydstyrke, så lange tryk stadig virker</string>
    <string name="settings_a11y_remap">Aktivér omtildeling af knapper</string>
    <string name="settings_a11y_remap_desc">Tjenesten opfanger tastetryk. Hvis du slår dette fra, undgår du problemer med lange tryk på lydstyrke, og at systemet stopper tjenesten, men tilsidesættelse af launcheren, forældrekontrol og registrering af inaktivitet kan blive mindre effektive.</string>
    <string name="settings_a11y_reminder">Vis påmindelse</string>

    <!-- First run -->
    <string name="firstrun_welcome_title">Velkommen!</string>
    <string name="firstrun_welcome_text">QLauncher er en launcher til Android TV. Den samler dine apps, kanaler og dit yndlingsindhold på én startskærm, som du kan tilpasse, med en skiftende baggrund bagved.</string>
    <string name="firstrun_features_title">Dine nye superkræfter</string>
    <string name="firstrun_features_text">Start en app eller en HDMI-indgang ved opstart, administrer skærmprofiler, lås apps med forældrekontrol, vis kalibreringsmønstre, registrer inaktivitet, og tilpas alle dele af startskærmen. Nogle funktioner afhænger af din enhed.</string>
    <string name="firstrun_a11y_title">Hjælpefunktioner, tak</string>
    <string name="firstrun_a11y_text">Mange funktioner kræver QLaunchers hjælpefunktionstjeneste: at erstatte den forudinstallerede launcher, handlinger ved opstart, knapgenveje på fjernbetjeningen, registrering af inaktivitet og forældrekontrol. Du kan slå den til nu eller senere i indstillingerne.</string>
    <string name="firstrun_a11y_open">Åbn indstillinger for hjælpefunktioner</string>
    <string name="firstrun_permissions_title">Hvis jeg må…</string>
    <string name="firstrun_permissions_text">Dernæst beder QLauncher om tilladelse til at læse tv-guiden (til kanaler og »Fortsæt med at se«) og om adgang til notifikationer (til notifikationsikonet og »Afspilles nu«). Begge dele er valgfrie.</string>
    <!-- Before Android 8 there are no channels, so only notification access is asked for. -->
    <string name="firstrun_permissions_text_no_channels">Dernæst beder QLauncher om adgang til notifikationer (til notifikationsikonet og »Afspilles nu«). Det er valgfrit.</string>
    <string name="firstrun_notifications_dialog">Vil du tillade adgang til notifikationer?</string>
    <string name="firstrun_notifications_text">Med adgang til notifikationer kan QLauncher vise et antal notifikationer, et notifikationspanel og det, der afspilles. »Ja« åbner siden Særlig appadgang, hvor du giver adgangen.</string>
    <string name="firstrun_reports_title">Vil du sende anonyme fejlrapporter?</string>
    <string name="firstrun_reports_text">Hvis QLauncher går ned eller støder på en fejl, kan den sende en rapport med appversionen og enhedsmodellen, så fejlen kan rettes. Intet, der identificerer dig eller det, du ser, bliver sendt. Du kan ændre det senere under Generelt.</string>
    <string name="firstrun_launcher_title">Gør QLauncher til din startskærm</string>
    <string name="firstrun_launcher_text">Mange tv-enheder lader dig ikke skifte standardlauncher. Hvis din gør, så vælg QLauncher dér. Ellers skal du slå hjælpefunktionstjenesten til med »Tilsidesæt nuværende launcher«, så kommer QLauncher tilbage, hver gang den forudinstallerede launcher åbnes.</string>
    <string name="firstrun_launcher_open">Skift standardlauncher</string>
    <string name="firstrun_start_title">Tid til at komme i gang!</string>
    <string name="firstrun_start_text">Alt kan ændres senere i indstillingerne. Tryk på indstillingsknappen øverst til højre, eller brug tastesekvensen ↑→↓←↑→↓←.</string>
    <string name="firstrun_get_started">KOM I GANG</string>

    <string name="settings_a11y_consent_title">Storitev dostopnosti</string>
    <string name="settings_a11y_consent">To QLauncherju omogoča, da vidi pritiske strojnih gumbov in ime aplikacije v ospredju. Oboje se hrani samo v pomnilniku te naprave in se nikoli nikamor ne pošlje. Se strinjaš?</string>
    <string name="settings_a11y_alternate">Uporabi nadomestno konfiguracijo</string>

    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Ative o serviço para executar uma ação na inicialização, personalizar os botões do controle remoto, reforçar o controle parental e detectar inatividade para o controle de energia. Ele vê os pressionamentos de teclas físicas e o nome do app em primeiro plano; ambos ficam na memória deste dispositivo e nunca são enviados a lugar nenhum.</string>
    <string name="settings_a11y_enabled">Ativado</string>
    <string name="settings_a11y_started">Iniciado</string>
    <string name="settings_yes">Sim</string>
    <string name="settings_no">Não</string>
    <string name="settings_a11y_open">Mostrar configurações de acessibilidade</string>
    <string name="settings_a11y_consent_title">Serviço de acessibilidade</string>
    <string name="settings_a11y_consent">Isso permite que o QLauncher veja os pressionamentos de botões físicos e o nome do app em primeiro plano. Ambos ficam somente na memória deste dispositivo e nunca são enviados a lugar nenhum. Você concorda?</string>
    <string name="settings_a11y_alternate">Usar configuração alternativa</string>
    <string name="settings_a11y_alternate_desc">Corrige problemas em alguns dispositivos</string>
    <string name="settings_a11y_volume_fix">Correção dos botões de volume</string>
    <string name="settings_a11y_volume_fix_desc">Pausa brevemente o remapeamento ao pressionar o volume, para que os toques longos continuem funcionando</string>
    <string name="settings_a11y_remap">Ativar remapeamento de botões</string>
    <string name="settings_a11y_remap_desc">O serviço intercepta os pressionamentos de teclas. Desativar isto evita problemas com o toque longo no volume e que o sistema interrompa o serviço, mas a substituição do launcher, o controle parental e a detecção de inatividade podem ficar menos eficazes.</string>
    <string name="settings_a11y_reminder">Mostrar lembrete</string>
    <string name="settings_a11y_reminder_desc">Se o serviço de acessibilidade estiver desativado</string>
    <string name="settings_a11y_unbound_toast">O serviço de acessibilidade do QLauncher não está em execução</string>


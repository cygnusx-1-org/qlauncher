    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Activa o servizo para executar unha acción no arranque, personalizar os botóns do mando, reforzar o control parental e detectar a inactividade para o control de enerxía. Ve as pulsacións das teclas físicas e o nome da aplicación en primeiro plano; ambos os datos quedan na memoria deste dispositivo e nunca se envían a ningures.</string>
    <string name="settings_a11y_enabled">Activado</string>
    <string name="settings_a11y_started">Iniciado</string>
    <string name="settings_yes">Si</string>
    <string name="settings_no">Non</string>
    <string name="settings_a11y_open">Amosar os axustes de accesibilidade</string>
    <string name="settings_a11y_consent_title">Servizo de accesibilidade</string>
    <string name="settings_a11y_consent">Isto permite que QLauncher vexa as pulsacións dos botóns físicos e o nome da aplicación en primeiro plano. Ambos os datos gárdanse só na memoria deste dispositivo e nunca se envían a ningures. Estás de acordo?</string>
    <string name="settings_a11y_alternate">Usar a configuración alternativa</string>
    <string name="settings_a11y_alternate_desc">Corrixe problemas nalgúns dispositivos</string>
    <string name="settings_a11y_volume_fix">Corrección dos botóns de volume</string>
    <string name="settings_a11y_volume_fix_desc">Deixa de reasignar brevemente ao premer o volume, para que as pulsacións longas sigan funcionando</string>
    <string name="settings_a11y_remap">Activar a reasignación de botóns</string>
    <string name="settings_a11y_remap_desc">O servizo intercepta as pulsacións de teclas. Desactivalo evita problemas coa pulsación longa do volume e que o sistema deteña o servizo, pero a substitución do lanzador, o control parental e a detección de inactividade poden ser menos eficaces.</string>
    <string name="settings_a11y_reminder">Amosar un recordatorio</string>
    <string name="settings_a11y_reminder_desc">Se o servizo de accesibilidade está desactivado</string>
    <string name="settings_a11y_unbound_toast">O servizo de accesibilidade de QLauncher non está en execución</string>


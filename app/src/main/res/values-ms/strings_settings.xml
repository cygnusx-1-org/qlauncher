    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Hidupkan perkhidmatan ini untuk menjalankan tindakan semasa but, menyesuaikan butang alat kawalan jauh, mengukuhkan kawalan ibu bapa dan mengesan masa melahu untuk kawalan kuasa. Ia melihat tekanan kekunci perkakasan dan nama apl di hadapan; kedua-duanya kekal dalam memori pada peranti ini dan tidak pernah dihantar ke mana-mana.</string>
    <string name="settings_a11y_enabled">Didayakan</string>
    <string name="settings_a11y_started">Dimulakan</string>

    <!-- First run -->
    <string name="firstrun_welcome_title">Velkommen!</string>
    <string name="firstrun_welcome_text">QLauncher er et startprogram for Android TV. Det samler appene, kanalene og favorittinnholdet ditt på én tilpassbar startskjerm, med et vekslende bakgrunnsbilde bak.</string>
    <string name="firstrun_features_title">Dine nye superkrefter</string>
    <string name="firstrun_features_text">Start en app eller en HDMI-inngang ved oppstart, administrer skjermprofiler, lås apper med foreldrekontroll, vis kalibreringsmønstre, oppdag inaktivitet og tilpass alle deler av startskjermen. Noen funksjoner avhenger av enheten din.</string>
    <string name="firstrun_a11y_title">Tid for tilgjengelighet</string>
    <string name="firstrun_a11y_text">Mange funksjoner trenger QLaunchers tilgjengelighetstjeneste: å erstatte det forhåndsinstallerte startprogrammet, handlinger ved oppstart, bevegelser med fjernkontrollknappene, inaktivitetsregistrering og foreldrekontroll. Du kan slå den på nå eller senere i innstillingene.</string>
    <string name="firstrun_a11y_open">Åpne tilgjengelighetsinnstillingene</string>
    <string name="firstrun_permissions_title">Om jeg får be…</string>
    <string name="firstrun_permissions_text">Deretter ber QLauncher om tillatelse til å lese TV-programoversikten (for kanaler og Se neste) og om tilgang til varsler (for varselikonet og Spilles nå). Begge deler er valgfrie.</string>
    <!-- Before Android 8 there are no channels, so only notification access is asked for. -->
    <string name="firstrun_permissions_text_no_channels">Deretter ber QLauncher om tilgang til varsler (for varselikonet og Spilles nå). Det er valgfritt.</string>
    <string name="firstrun_notifications_dialog">Gi tilgang til varsler?</string>
    <string name="firstrun_notifications_text">Med tilgang til varsler kan QLauncher vise antall varsler, et varselpanel og hva som spilles av. Ja åpner siden Spesiell apptilgang, der du gir tilgangen.</string>
    <string name="firstrun_reports_title">Sende anonyme krasj- og feilrapporter?</string>
    <string name="firstrun_reports_text">Hvis QLauncher krasjer eller får en feil, kan den sende en rapport med appversjonen og enhetsmodellen slik at feilen kan rettes. Ingenting som identifiserer deg eller det du ser på, blir sendt. Du kan endre dette senere under Generelt.</string>
    <string name="firstrun_launcher_title">Gjør QLauncher til startskjermen din</string>
    <string name="firstrun_launcher_text">Mange TV-enheter lar deg ikke endre standardstartprogrammet. Hvis din gjør det, velger du QLauncher der. Ellers slår du på tilgjengelighetstjenesten med «Overstyr gjeldende startprogram», så kommer QLauncher tilbake hver gang det forhåndsinstallerte startprogrammet åpnes.</string>
    <string name="firstrun_launcher_open">Endre standardstartprogram</string>
    <string name="firstrun_start_title">På tide å begynne!</string>
    <string name="firstrun_start_text">Alt kan endres senere i innstillingene. Trykk på innstillingsknappen øverst til høyre, eller tastesekvensen ↑→↓←↑→↓←.</string>

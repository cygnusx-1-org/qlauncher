    <!-- Accessibility service -->
    <string name="settings_a11y_desc">Slå på tjenesten for å kjøre en handling ved oppstart, tilpasse fjernkontrollknappene, styrke foreldrekontrollen og oppdage inaktivitet for strømstyring. Den ser trykk på maskinvaretaster og navnet på appen i forgrunnen; begge deler blir værende i minnet på denne enheten og sendes aldri noe sted.</string>
    <string name="settings_a11y_enabled">Aktivert</string>

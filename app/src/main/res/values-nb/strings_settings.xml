    <string name="settings_a11y_remap">Aktiver ommapping av knapper</string>
    <string name="settings_a11y_remap_desc">Tjenesten fanger opp tastetrykk. Hvis du slår av dette, unngår du problemer med lange trykk på volumknappene og at systemet stopper tjenesten, men overstyringen av startprogrammet, foreldrekontrollen og inaktivitetsregistreringen kan bli mindre effektive.</string>
